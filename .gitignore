# =============================================================================
# EducationOS — Master Git Ignore Rules
# Strictly prevents secret leakage, uploads, caches, build artifacts & dumps.
# =============================================================================

# --- Environment & Secret Configuration ---
.env
.env.*
!.env.example
!.env.template
frontend/.env.local
frontend/.env.*.local
*.local
.qa-credentials.local
*.secret
*.key
*.pem
*.p12
*.pfx
*.cert
*.crt

# --- Python & Virtual Environments ---
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Testing, Coverage & Cache ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
test-results/
playwright-report/
test-results/

# --- Node & Frontend Build Artifacts ---
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Local Uploads & Static Assets ---
backend/uploads/
uploads/
backend/backups/
backups/

# --- Audit Logs, Diff Dumps & Temporary Scans ---
*.diff
*.patch
.stage*.diff
potential_secrets.txt
tenant_query_anomalies.txt
security_bandit_report.json
*bandit*
ui-audit/
*.log
logs/

# --- Databases & Dumps ---
*.db
*.sqlite3
*.sql.dump
*.dump

# --- OS & IDE Metadata ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
