# EducationOS / SchoolOS Backend Environment Configuration Example
# Copy this file to .env and populate with production / staging secrets.

# --- Database & Connection Pooling ---
# Supabase PgBouncer Transaction Pooler or Native PostgreSQL URL
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800

# --- Core Security & Tokens ---
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Object Storage (S3 / Cloudflare R2 / AWS / Local) ---
# Supported values: "s3" (AWS / MinIO / Ceph), "r2" (Cloudflare R2), "local"
STORAGE_BACKEND=local
STORAGE_BUCKET=educationos-assets
# For Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_LOCAL_PATH=uploads

# --- AI & Vector Embeddings ---
GEMINI_API_KEY=
GEMINI_RPM_LIMIT=60
GEMINI_TPM_LIMIT=60000

# --- Communication: Email Gateways ---
# Supported providers: "resend", "brevo", "smtp", "mock"
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@educationos.local
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@educationos.local
SMTP_FROM_NAME=EducationOS Platform
SMTP_USE_TLS=true
ALLOW_MOCK_EMAIL=false

# --- Communication: SMS Gateways ---
# Supported providers: "greenweb", "osel", "sslwireless", "mock"
SMS_GATEWAY_PROVIDER=greenweb
GREENWEB_API_KEY=
OSEL_API_KEY=
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER_ID=EDUSYS
ALLOW_MOCK_SMS=false

# --- Application Metadata ---
APP_ENV=production
TIMEZONE=Asia/Dhaka
DEFAULT_TENANT_ID=dev-tenant

